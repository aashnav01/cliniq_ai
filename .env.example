# ── Google Gemini — get your key at https://aistudio.google.com ───────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── MongoDB Atlas — get your URI at https://cloud.mongodb.com ────────────────
# Format: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://cliniq_user:your_password@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

# ── Groq (Whisper STT only — LLM tasks now use Gemini) ───────────────────────
# Get your key at https://console.groq.com — needed for voice dictation
GROQ_API_KEY=your_groq_api_key_here

# ── Redis (optional — app works without it; caches analysis results) ──────────
REDIS_URL=redis://localhost:6379

# ── App ───────────────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development

# ── Frontend (Vite reads VITE_ prefix) ───────────────────────────────────────
VITE_API_URL=http://localhost:8000

# ── Security — generate with: python -c "import secrets; print(secrets.token_hex(32))" ──
SECRET_KEY=your_secret_key_here
